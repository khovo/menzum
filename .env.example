# .env.example — combined reference for every environment variable this
# repo's code actually reads, across all three deployment targets. Copy to
# .env for local runs; .env* is gitignored, never commit real values.
#
# NOTE ON TOPOLOGY (see CLAUDE.md): this repo deploys as separate Vercel
# projects. Vars below are grouped by which project actually needs them —
# setting a var in the wrong project's dashboard has no effect.
#   - "Bot project" (repo root, vercel.json)      -> menzum.vercel.app
#   - "Frontend project" (webapp/, webapp/vercel.json) -> almadih.vercel.app
#   - "Admin panel project" (admin/) has its own admin/.env.example — the
#     ~10 vars there (ADMIN_EMAIL, ADMIN_SECRET, R2 creds, etc.) are NOT
#     duplicated here; see that file directly.

# ── Bot project: Python Telegram bot (api/index.py, handlers/, db.py) ────────
# Also shared by the Node webapp API below — same Vercel project/deployment.
MONGO_URL=
BOT_TOKEN=
ADMIN_ID=

# Verified against Telegram's X-Telegram-Bot-Api-Secret-Token header on every
# webhook POST (api/index.py) — without it, anyone who finds the webhook URL
# could forge admin commands. Must also be registered via Telegram's
# setWebhook API, not just set here — see the C1 deploy runbook.
TELEGRAM_WEBHOOK_SECRET=

# Optional — defaults shown are what the code falls back to if unset.
BOT_USERNAME=Almadihbot
API_BASE=https://menzum.vercel.app

# ── Bot project: Node webapp API (api/webapp/*.js) ───────────────────────────
# Backs the Telegram Mini App + the Flutter mobile app's REST calls.
ADMIN_TOKEN=
JWT_SECRET=

# ── Frontend project: Next.js Mini App (webapp/) ─────────────────────────────
# Set on the SEPARATE almadih.vercel.app Vercel project, not the bot project —
# points the Mini App at the bot project's API.
NEXT_PUBLIC_API_BASE=https://menzum.vercel.app

# ── scripts/migrate_from_telegram.py (manual R2 migration, not deployed) ────
# Reuses MONGO_URL/BOT_TOKEN above. R2 credentials are separate from the
# admin panel's own (admin/.env.example) — this is the migration script's
# own bucket/account.
R2_ENDPOINT_URL=https://xxxx.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=xxxx
R2_SECRET_ACCESS_KEY=xxxx
R2_BUCKET_NAME=almadih-files
R2_PUBLIC_URL=https://pub-xxxx.r2.dev
