# Copy to .env.local for local dev. Never commit real values — .env* is gitignored.

# Shared MongoDB (same MenzumaDB the bot + webapp use)
MONGO_URL=

# Admin login (single account). Generate the hash with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_EMAIL=admin@almadih.app
ADMIN_PASSWORD_HASH=
ADMIN_JWT_SECRET=

# R2 — audio bucket (can reuse the same credentials as the migration script)
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=almadih-files
R2_PUBLIC_URL=

# R2 — separate PDF bucket/credentials
R2_PDF_ENDPOINT_URL=
R2_PDF_ACCESS_KEY_ID=
R2_PDF_SECRET_ACCESS_KEY=
R2_PDF_BUCKET_NAME=almadih-pdfs
R2_PDF_PUBLIC_URL=
