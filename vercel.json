{
  "version": 2,
  "builds": [
    { "src": "api/index.py",    "use": "@vercel/python" },
    { "src": "api/webapp/*.js", "use": "@vercel/node"   }
  ],
  "routes": [
    { "src": "/api/webapp/(.*)", "dest": "/api/webapp/$1.js" },
    { "src": "/(.*)",            "dest": "/api/index.py"     }
  ]
}
